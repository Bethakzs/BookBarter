# Скопіюй цей файл у ci/.env і заповни значення.  ci/.env НЕ комітиться (див. .gitignore).

# Адмін Jenkins (створюється автоматично через JCasC)
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me

# Репозиторій, який збирає Jenkins
GIT_REPO_URL=https://github.com/Bethakzs/BookBarter.git
GIT_BRANCH=main

# Docker Hub: логін і Personal Access Token (Docker Hub -> Account settings -> Personal access tokens, права Read & Write)
DOCKERHUB_USER=bethakzs
DOCKERHUB_TOKEN=

# SonarQube: токен генерується в UI SonarQube (My Account -> Security -> Generate Token, тип Global Analysis Token)
SONAR_TOKEN=

# Секрети застосунку, які пайплайн кладе в Kubernetes Secret "bookbarter-secrets"
APP_DB_PASSWORD=change-me
APP_JWT_SECRET=change-me-to-a-long-random-string

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Пароль адміна SonarQube (довідково; змінюється в UI SonarQube)
SONAR_ADMIN_PASSWORD=

# Kubernetes Docker Desktop (kind). Значення за замовчуванням підходять для Docker Desktop
# K8S_NETWORK=kind
# K8S_NODE=desktop-control-plane
# K8S_API_SERVER=https://desktop-control-plane:6443
